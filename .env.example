# Laptop profile only. Never place secrets in this file.
PARCEL_SORTER_PROFILE=laptop
PARCEL_SORTER_LOG_LEVEL=INFO

# Set this locally to the synced/mounted Google Drive project folder when needed.
PARCEL_SORTER_DRIVE_ROOT=

# Final ONNX bundle downloaded from Google Drive for laptop software testing.
PARCEL_SORTER_MODEL_DIR=./models/current

# Runtime secrets such as QR HMAC keys belong in an ignored .env or secret store.
